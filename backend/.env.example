# ================= Sanatan API — Backend environment =================
# Copy this file to `.env` and fill in your values. Never commit `.env`.

# --- Server ---
PORT=8080
NODE_ENV=development
# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5500

# --- Supabase ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service-role key: server-side ONLY. Never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# --- Redis / Upstash (rate limiting + usage counters) ---
# Leave REDIS_URL blank to fall back to an in-memory limiter (dev only).
REDIS_URL=
# If your Redis provider needs TLS (Upstash does), set true.
REDIS_TLS=false

# --- Tier limits ---
FREE_TIER_MONTHLY=1000
FREE_TIER_RPS=10
FREE_TIER_KEYS=2

# --- API key namespace ---
KEY_PREFIX=sanatan-
